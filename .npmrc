public-hoist-pattern[]=*@brillout*

# Do not auto-install a dependency's peers (#97). @payloadcms/richtext-lexical declares Next.js
# peers and @payloadcms/ui depends on it with `next` as a required peer, so pnpm used to install a
# whole Next.js subtree this Vike app never runs — nine advisories, two of them critical, for code
# that has no entry point here. Neither `pnpm.overrides` nor `peerDependencyRules.ignoreMissing`
# reaches it; only this switch closes both inbound paths.
# Consequence: a peer this app actually needs must now be declared as a direct dependency.
auto-install-peers=false
