{
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "vike dev",
    "build": "vike build",
    "preview": "vike preview",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "vitest run --config vitest.smoke.config.ts tests/smoke/web",
    "test:smoke:ladle": "vitest run --config vitest.smoke.config.ts tests/smoke/ladle",
    "prod": "vike build && wrangler dev ./dist/server/index.js -c ./dist/server/wrangler.json",
    "deploy": "vike build && wrangler deploy",
    "ladle": "ladle serve",
    "ladle:build": "SWC_NATIVE_BINDING_CACHE_SKIP_SECURITY_CHECK=${WORKERS_CI:+1} ladle build",
    "check:wrangler": "wrangler deploy --dry-run --config wrangler.design.jsonc",
    "env:setup": "cp .env.example .env.local && echo 'Created .env.local! Edit it with your actual values.'",
    "types:cms": "curl -fsSL -o types/payload/payload-types.ts https://raw.githubusercontent.com/sydevs/SahajCloud/refs/heads/main/src/payload-types.ts && node scripts/strip-payload-augmentation.mjs",
    "sync:translations": "tsx scripts/sync-translations.mjs"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@heroicons/react": "^2.2.0",
    "@mapbox/search-js-core": "^1.6.0",
    "@mapbox/search-js-react": "^1.6.0",
    "@mapbox/search-js-web": "^1.6.0",
    "@marsidev/react-turnstile": "^1.6.3",
    "@payloadcms/live-preview": "3.93.0",
    "@payloadcms/live-preview-react": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/sdk": "3.93.0",
    "@photonjs/hono": "^0.1.12",
    "@sentry/cloudflare": "11.13.0",
    "@sentry/react": "11.13.0",
    "@unhead/schema-org": "3.4.3",
    "@videojs/hlsjs-video": "10.5.0",
    "@videojs/react": "10.5.0",
    "embla-carousel-react": "^8.6.0",
    "hono": "^4.13.19",
    "jose": "6.2.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-masonry-css": "^1.0.16",
    "react-use-audio-player": "^4.0.2",
    "unhead": "3.4.3",
    "vike": "^0.4.270",
    "vike-photon": "^0.1.26",
    "vike-react": "^0.6.32",
    "yet-another-react-lightbox": "^3.33.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "@eslint-react/eslint-plugin": "^5.30.3",
    "@ladle/react": "^5.1.1",
    "@photonjs/cloudflare": "^0.1.13",
    "@sentry/vite-plugin": "^11.13.0",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.14.0",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.163.0"
  },
  "pnpm": {
    "overrides": {
      "glob@>=9.0.0 <14.0.2": "14.0.6",
      "happy-dom@<21.0.4": "21.0.4",
      "ts-deepmerge@<8.0.0": "8.0.0",
      "undici@>=7.18.0 <7.30.1": "7.30.1"
    }
  },
  "type": "module"
}
