# .env.example
#
# SETUP:
# 1. Copy this file to .env.local:
#    cp .env.example .env.local
# 2. Edit .env.local with your real values.
#
# Both development modes read .env.local:
# - Vite development (pnpm dev) reads .env.local.
# - Cloudflare Workers (pnpm prod) falls back to .env.local.
#
# PRODUCTION:
# - Secrets: Set them as encrypted vars in the Cloudflare dashboard, under
#   Workers & Pages → wemeditate-web → Settings → Environment variables.
# - Public build-time vars: Defined in .env.production (committed to git).

# =============================================================================
# SERVER-SIDE ONLY (Never exposed to browser)
# =============================================================================

# SahajCloud (PayloadCMS) API Key
# Required for all CMS data fetching
SAHAJCLOUD_API_KEY=

# Server-side Sentry DSN (for server error tracking)
SENTRY_DSN=

# =============================================================================
# BROWSER-ACCESSIBLE (Embedded in client bundles at build time)
# =============================================================================
#
# Vite embeds each PUBLIC__* variable at build time.
# In production, fixed values sit in .env.production (committed to git).
# In development, values come from .env.local (this file, gitignored).
#
# Note: "PUBLIC__" means the browser can access the variable.
# It does not mean the value is public knowledge.
# Variables like PUBLIC__MAPBOX_ACCESS_TOKEN are still your secrets.

# SahajCloud CMS URL
# Development: http://localhost:3000 (local PayloadCMS)
# Production: Defined in .env.production
PUBLIC__SAHAJCLOUD_URL=http://localhost:3000

# Mapbox API token for LocationSearch component
# Get from: https://account.mapbox.com/access-tokens/
# Restrict token by domain for security
PUBLIC__MAPBOX_ACCESS_TOKEN=

# Client-side Sentry DSN (for browser error tracking)
PUBLIC__SENTRY_DSN=

# Optional: External status page URL
# Displayed in error messages when CMS is unavailable
# Example: https://status.wemeditate.com
PUBLIC__STATUS_PAGE_URL=

# Sahaj Atlas widget key for the /map pages
# Ask the Sahaj Atlas maintainers for one.
# Unlike the other PUBLIC__ values, this one really is public knowledge.
# It ships in the page HTML. It is scoped to read-only atlas data.
# When this key is unset, /map still server-renders its content.
# It just does not mount the interactive widget over that content.
PUBLIC__SAHAJ_ATLAS_KEY=
