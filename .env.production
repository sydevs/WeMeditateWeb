# .env.production
#
# Production environment variables embedded at build time by Vite.
# This file is committed to git (contains no secrets).
#
# These are used when Cloudflare auto-builds from git, since wrangler.toml [vars]
# are runtime-only and not available during the Vite build step.

# SahajCloud SahajCloud URL (PayloadCMS)
# This is the same value as in wrangler.toml [vars], but needed here for Vite build-time
PUBLIC__SAHAJCLOUD_URL=https://cloud.sydevelopers.com

# Ed25519 PUBLIC key that verifies live-preview tokens minted by SahajCloud.
#
# Committed on purpose, and safe to: a verification key cannot mint, so
# publishing it costs nothing — and it is what lets this site check a token
# without holding a shared secret that would have to be kept in step with the
# SahajCloud. Unset, live preview is simply unavailable and every request renders
# published content.
#
# Rotating it means rotating SahajCloud's LIVE_PREVIEW_SIGNING_KEY in the same
# window, or every panel shows the "not configured" page until they agree.
PUBLIC__LIVE_PREVIEW_VERIFY_KEY=0Ux5Hp4TiloiW6C/SFgGJEmJGiOLcMS5U52D/TbKKyQ=

# Cloudflare Turnstile SITE key. Deliberately absent, not forgotten.
#
# It belongs here once a widget covering this site's domains exists and
# SahajCloud holds the matching secret — see .env.example for why the pair
# must match. Until then every form submission is refused with
# captcha_failed, because SahajCloud requires a token on every public write.
# A value set in the Cloudflare dashboard's build variables works too, and
# wins for a preview built from a branch.
